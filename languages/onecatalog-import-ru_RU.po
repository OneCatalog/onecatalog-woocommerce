msgstr ""
"Project-Id-Version: OneCatalog Import 1.0.0\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: ru_RU\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<12 || n%100>14) ? 1 : 2);\n"

msgid "OneCatalog Settings"
msgstr "Настройки OneCatalog"

#. translators: 1: link to the Products admin page, 2: import button label
msgid "Product import lives on the %1$s page — use the “%2$s” button next to “Export”."
msgstr "Импорт товаров — на странице %1$s: кнопка «%2$s» рядом с «Экспорт»."

msgid "Products"
msgstr "Товары"

msgid "OneCatalog (Products)"
msgstr "OneCatalog(Товары)"

msgid "OneCatalog documentation"
msgstr "Документация OneCatalog"

msgid "Settings saved."
msgstr "Настройки сохранены."

msgid "Wiki API token"
msgstr "Токен Wiki API"

#. translators: %s: Wiki API base URL
msgid "Sent as the X-API-Key header to Wiki API requests and to the product picker. API: %s. With a token, images are downloaded in maximum quality; files previously downloaded in lower quality are replaced automatically when the product is imported again."
msgstr "Передаётся заголовком X-API-Key в запросы Wiki API и в модалку выбора товаров. API: %s. С токеном изображения загружаются в максимальном качестве; загруженные ранее в низком качестве заменяются автоматически при повторном импорте товара."

msgid "Warning:"
msgstr "Внимание:"

msgid "a token environment variable is set — it takes priority over this field."
msgstr "задана переменная окружения с токеном — она имеет приоритет над этим полем."

msgid "Import step"
msgstr "Шаг импорта"

#. translators: %d: minimum step value
msgid "Number of products processed per background queue run (minimum %d). Selected products are never loaded all at once."
msgstr "Сколько товаров обрабатывается за один проход фоновой очереди (минимум %d). Выбранные товары не загружаются все сразу."

msgid "Products language"
msgstr "Язык товаров"

msgid "Language of product names and specifications loaded from OneCatalog (Wiki API “lang” parameter; en, ru, ar, zh and kk are supported). Defaults to English."
msgstr "Язык названий и характеристик, загружаемых из OneCatalog (параметр «lang» Wiki API; поддерживаются en, ru, ar, zh и kk). По умолчанию — английский."

msgid "Save settings"
msgstr "Сохранить настройки"

msgid "Loading OneCatalog…"
msgstr "Загрузка OneCatalog…"

#. translators: %1$s: number of products
msgid "OneCatalog: queueing %1$s product(s)…"
msgstr "OneCatalog: ставим в очередь %1$s товар(ов)…"

#. translators: 1: products, 2: batches, 3: step
msgid "OneCatalog: %1$s product(s) queued, %2$s batch(es) of %3$s. Running in background…"
msgstr "OneCatalog: в очереди %1$s товар(ов), порций: %2$s по %3$s. Выполняется в фоне…"

#. translators: 1: batches left, 2: total batches
msgid "OneCatalog: running in background — %1$s of %2$s batch(es) left…"
msgstr "OneCatalog: выполняется в фоне — осталось порций: %1$s из %2$s…"

#. translators: 1: imported, 2: total
msgid "OneCatalog: imported %1$s of %2$s."
msgstr "OneCatalog: импортировано %1$s из %2$s."

msgid "Errors:"
msgstr "Ошибки:"

msgid "Refresh list"
msgstr "Обновить список"

msgid "OneCatalog: error — "
msgstr "OneCatalog: ошибка — "

msgid "OneCatalog: network error — "
msgstr "OneCatalog: ошибка сети — "

msgid "OneCatalog SKU"
msgstr "Артикул OneCatalog"

msgid "OneCatalog product identifier (public_id). Filled by the import and used to update the product on re-import."
msgstr "Идентификатор товара в OneCatalog (public_id). Заполняется импортом; по нему товар обновляется при повторном импорте."

msgid "WooCommerce is not active"
msgstr "WooCommerce не активен"

msgid "Empty ID list"
msgstr "Пустой список ID"

msgid "product not found in the OneCatalog API"
msgstr "товар не найден в OneCatalog API"

msgid "Documentation"
msgstr "Документация"

msgid "Settings"
msgstr "Настройки"

#. Plugin Name of the plugin
msgid "OneCatalog Import"
msgstr "OneCatalog Import"

#. Description of the plugin
msgid "Import products from OneCatalog (Wiki API) into WooCommerce: product picker modal, background queue, dependencies (categories, attributes, collections, brands), images with quality tracking, separate article numbers."
msgstr "Импорт товаров из OneCatalog (Wiki API) в WooCommerce: модалка выбора товаров, фоновая очередь, зависимости (категории, характеристики, коллекции, бренды), изображения с трекингом качества, раздельные артикулы."

#. Author URI of the plugin
msgid "https://docs.onecatalog.net/"
msgstr "https://docs.onecatalog.net/"

msgid "OneCatalog"
msgstr "OneCatalog"

msgid "Collections"
msgstr "Коллекции"

msgid "Import collections"
msgstr "Импортировать коллекции"

msgid "Create/update collections together with products"
msgstr "Создавать/обновлять коллекции вместе с товарами"

msgid "Store collections as"
msgstr "Хранить коллекции как"

msgid "Post type"
msgstr "Тип записи"

msgid "Taxonomy"
msgstr "Таксономию"

msgid "Whether each collection becomes a post (CPT) or a taxonomy term. Select the specific target below."
msgstr "Сделать каждую коллекцию записью (CPT) или термином таксономии. Конкретную цель выберите ниже."

msgid "Target post type"
msgstr "Целевой тип записи"

msgid "Used when collections are stored as a post type."
msgstr "Используется, когда коллекции хранятся как тип записи."

msgid "Target taxonomy"
msgstr "Целевая таксономия"

msgid "Used when collections are stored as a taxonomy."
msgstr "Используется, когда коллекции хранятся как таксономия."

msgid "Imported collection fields: title, slug, OneCatalog ID, cover image, 3D link, official site link."
msgstr "Импортируемые поля коллекции: название, ярлык, ID OneCatalog, обложка, 3D-ссылка, ссылка на официальный сайт."

msgid "— select —"
msgstr "— выберите —"

msgid "Characteristic mapping"
msgstr "Сопоставление характеристик"

msgid "Manual mapping"
msgstr "Ручное сопоставление"

msgid "Bind OneCatalog characteristics to existing WooCommerce attributes"
msgstr "Привязать характеристики OneCatalog к существующим атрибутам WooCommerce"

msgid "Off: each characteristic is matched to a global attribute by name, creating it if missing (default). On: only the characteristics bound on the “Characteristics” page are imported — unbound ones are skipped."
msgstr "Выкл: каждая характеристика сопоставляется с глобальным атрибутом по названию, при отсутствии создаётся (по умолчанию). Вкл: импортируются только характеристики, привязанные на странице «Характеристики», — непривязанные пропускаются."

msgid "Configure characteristics →"
msgstr "Настроить характеристики →"

msgid "Enable and save — a “Characteristics” submenu will appear under OneCatalog for configuring the bindings."
msgstr "Включите и сохраните — в меню OneCatalog появится подпункт «Характеристики» для настройки привязок."

msgid "Characteristics"
msgstr "Характеристики"

msgid "Manual mapping is off. Enable it on the OneCatalog settings page first."
msgstr "Ручное сопоставление выключено. Сначала включите его на странице настроек OneCatalog."

msgid "← OneCatalog settings"
msgstr "← Настройки OneCatalog"

msgid "Bind OneCatalog characteristics to existing WooCommerce attributes. On import a bound characteristic is resolved to its attribute; unbound characteristics are skipped."
msgstr "Привязка характеристик OneCatalog к существующим атрибутам WooCommerce. При импорте привязанная характеристика берёт свой атрибут; непривязанные характеристики пропускаются."

msgid "Bindings saved."
msgstr "Привязки сохранены."

msgid "Could not load the characteristics list from the Wiki API (check the token / connection). Already-saved bindings are kept."
msgstr "Не удалось загрузить список характеристик из Wiki API (проверьте токен/соединение). Уже сохранённые привязки остаются."

msgid "OneCatalog characteristic"
msgstr "Характеристика OneCatalog"

msgid "WooCommerce attribute"
msgstr "Атрибут WooCommerce"

msgid "— select characteristic —"
msgstr "— выберите характеристику —"

msgid "characteristic #%d (not in list)"
msgstr "характеристика №%d (нет в списке)"

msgid "— skip (no binding) —"
msgstr "— пропустить (без привязки) —"

msgid "+ Add binding"
msgstr "+ Добавить привязку"

msgid "↻ Refresh characteristics"
msgstr "↻ Обновить характеристики"

msgid "No WooCommerce attributes exist yet — create them under %s, then bind here."
msgstr "Атрибутов WooCommerce пока нет — создайте их в %s, затем настройте привязку здесь."

msgid "Products → Attributes"
msgstr "Товары → Атрибуты"

msgid "The characteristics list is loaded from the Wiki API (cached). Values are still matched by name (or created) inside the bound attribute."
msgstr "Список характеристик загружается из Wiki API (с кэшем). Значения по-прежнему сопоставляются по названию (или создаются) внутри привязанного атрибута."

msgid "Save bindings"
msgstr "Сохранить привязки"

msgid "New product status"
msgstr "Статус новых товаров"

msgid "Status assigned to products created by the import. Existing products keep their current status on re-import."
msgstr "Статус, который присваивается товарам, созданным импортом. У существующих товаров статус при переимпорте не меняется."

msgid "Brand"
msgstr "Производитель (Бренд)"

msgid "Import brands"
msgstr "Импорт брендов"

msgid "Assign the product brand on import"
msgstr "Назначать бренд товара при импорте"

msgid "Store brand as"
msgstr "Хранить бренд как"

msgid "Whether each brand becomes a post (CPT) or a taxonomy term. Select the specific target below."
msgstr "Хранить каждый бренд как запись (CPT) или как термин таксономии. Конкретную цель выберите ниже."

msgid "Used when brands are stored as a post type."
msgstr "Используется, когда бренды хранятся как тип записи."

msgid "Used when brands are stored as a taxonomy."
msgstr "Используется, когда бренды хранятся как таксономия."

msgid "For each OneCatalog characteristic pick the WooCommerce attribute to bind it to. Characteristics left unbound are skipped on import."
msgstr "Для каждой характеристики OneCatalog выберите атрибут WooCommerce, к которому её привязать. Непривязанные характеристики при импорте пропускаются."

msgid "No characteristics found. Set the Wiki API token, then use “Refresh characteristics”."
msgstr "Характеристики не найдены. Укажите токен Wiki API и нажмите «Обновить характеристики»."

msgid "Attribute (characteristic)"
msgstr "Атрибут (характеристика)"

msgid "Attribute — a product attribute pa_* (legacy WooCommerce, brand shown among attributes). Taxonomy — the product_brand taxonomy (current WooCommerce brands). Post type — a CPT. Select the specific target below."
msgstr "Атрибут — товарный атрибут pa_* (старый способ WooCommerce, бренд показывается среди атрибутов). Таксономия — таксономия product_brand (новые бренды WooCommerce). Тип записи — CPT. Конкретную цель выберите ниже."

msgid "Brand attribute"
msgstr "Атрибут бренда"

msgid "Used when the brand is stored as a product attribute (legacy way). Don’t have a brand attribute? Create one under %s."
msgstr "Используется, когда бренд хранится как товарный атрибут (старый способ). Нет атрибута для бренда? Создайте его в %s."

msgid "Country of origin"
msgstr "Страна происхождения"

msgid "Import country"
msgstr "Импорт страны"

msgid "Assign the country of origin on import"
msgstr "Назначать страну происхождения при импорте"

msgid "Store country as"
msgstr "Хранить страну как"

msgid "Country is most often a product attribute. Pick the target below."
msgstr "Страна чаще всего — товарный атрибут. Конкретную цель выберите ниже."

msgid "Country attribute"
msgstr "Атрибут страны"

msgid "Used when the country is stored as a product attribute. No country attribute yet? Create one under %s."
msgstr "Используется, когда страна хранится как товарный атрибут. Нет атрибута страны? Создайте его в %s."

msgid "Used when the country is stored as a taxonomy."
msgstr "Используется, когда страна хранится как таксономия."

msgid "Tags"
msgstr "Теги"

msgid "Import tags"
msgstr "Импорт тегов"

msgid "Import product tags into the product_tag taxonomy"
msgstr "Импортировать теги товара в таксономию product_tag"

msgid "Tags are matched by name (label) — an existing tag is reused, otherwise created."
msgstr "Теги ищутся по названию: существующий переиспользуется, иначе создаётся."

msgid "yes / no"
msgstr "да / нет"

msgid "value for “true”"
msgstr "значение для «true»"

msgid "value for “false”"
msgstr "значение для «false»"

msgid "e.g. Yes"
msgstr "напр. Да"

msgid "e.g. No"
msgstr "напр. Нет"

msgid "Boolean characteristic: the chosen value becomes a term in the bound attribute. Leave empty to skip that case."
msgstr "Логическая характеристика: выбранное значение становится термином в привязанном атрибуте. Пусто — этот случай пропускается."

msgid "— not set —"
msgstr "— не задавать —"

msgid "Boolean characteristic: pick a term from the bound attribute for true / false. Empty (or no value from OneCatalog) counts as false."
msgstr "Логическая характеристика: выберите термин привязанного атрибута для true / false. Пусто (или отсутствие значения из OneCatalog) считается false."

msgid "Whether each collection becomes a product attribute pa_*, a taxonomy term, or a post (CPT). Select the specific target below."
msgstr "Хранить каждую коллекцию как товарный атрибут pa_*, термин таксономии или запись (CPT). Конкретную цель выберите ниже."

msgid "Collection attribute"
msgstr "Атрибут коллекции"

msgid "Used when the collection is stored as a product attribute. No collection attribute yet? Create one under %s."
msgstr "Используется, когда коллекция хранится как товарный атрибут. Нет атрибута коллекции? Создайте его в %s."
